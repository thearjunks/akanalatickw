{
  "name": "ga4-event-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/server.js",
    "dev:web": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build",
    "postinstall": "npm run build",
    "start": "node server/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
